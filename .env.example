# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meshofoundation?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS. Comma-separated.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8080

# --- SMTP (Gmail App Password recommended) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mesho Foundation <you@example.com>"

# When "true", and email delivery fails, the OTP is returned in the API
# response so the dev UI can display it. NEVER set this in production.
DEV_RETURN_OTP=false

# --- Razorpay (Standard Checkout) ---
# Get test keys from https://dashboard.razorpay.com/app/keys
# KEY_SECRET stays on the server — never expose it to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
